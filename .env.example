# Tal Taxi — Umgebungsvariablen (Beispiel)
# Kopieren nach .env und Werte einsetzen.

# Öffentliche URL der Website (für SEO, Sitemap, OpenGraph)
SITE_URL="https://www.tal-taxi.at"

# Datenbank
# Lokal (Entwicklung): SQLite
DATABASE_URL="file:./dev.db"
# Produktion (Vercel): PostgreSQL, z. B.
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/db?sslmode=require"

# Auth — zufälligen, langen Wert verwenden! (z. B. `openssl rand -base64 32`)
AUTH_SECRET="bitte-zufaelligen-wert-eintragen"

# Standard-Admin (nur für den ersten Seed)
ADMIN_EMAIL="admin@tal-taxi.at"
ADMIN_PASSWORD="bitte-aendern"

# Google Maps Platform (optional, für automatische Distanzberechnung)
GOOGLE_MAPS_API_KEY=""

# E-Mail-Versand (Resend) — ohne Key werden E-Mails nur protokolliert
RESEND_API_KEY=""
MAIL_FROM="Tal Taxi <info@tal-taxi.at>"
BOOKING_NOTIFY_EMAIL="info@tal-taxi.at"
